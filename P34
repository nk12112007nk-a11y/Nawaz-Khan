import math

a, b, c = map(float, input().split())

d = b * b - 4 * a * c

if d > 0:
    root1 = (-b + math.sqrt(d)) / (2 * a)
    root2 = (-b - math.sqrt(d)) / (2 * a)
    print("Real and distinct roots")
    print(root1, root2)

elif d == 0:
    root = -b / (2 * a)
    print("Real and equal roots")
    print(root)

else:
    real = -b / (2 * a)
    imaginary = math.sqrt(-d) / (2 * a)
    print("Imaginary roots")
    print(f"{real}+{imaginary}i")
    print(f"{real}-{imaginary}i")
